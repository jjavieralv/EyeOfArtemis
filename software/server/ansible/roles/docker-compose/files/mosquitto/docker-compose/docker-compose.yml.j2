services:
  mosquitto:
    image: {{ image.name }}:{{ image.version }}
    {% if image.pull_policy is defined -%}
    pull_policy: {{ image.pull_policy }}
    {% endif %}

    restart: {{restart}}
    container_name: {{ container_name}}
    {% if configs is defined -%}
    configs:
      {% for conf in configs -%}
      - {{ conf }}
      {% endfor %}
    {%- endif %}

    {% if entrypoint is defined -%}
    entrypoint: {{entrypoint}}
    {% endif %}

    ports:
      - {{mosquitto.listener}}:{{mosquitto.listener}}

{% if configs is defined %}
configs:
{% for conf in configs %}
  {{ conf }}:
    file: ../config{{ configs[conf] }}
{% endfor %}
{% endif %}
